rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appConfig/schoolServer {
      allow get: if request.auth != null;
      allow write, list: if false;
    }
    match /users/{uid}/billing/subscription {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Stripe webhook writes using the server Admin SDK only.
      allow write: if false;
    }
    match /users/{uid}/trips/{tripId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validSummary() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion', 'id', 'vehicle', 'start', 'end', 'distance', 'averageRisk', 'readingCount', 'eventCount'])
          && d.keys().hasOnly(['schemaVersion', 'id', 'vehicle', 'start', 'end', 'distance', 'averageRisk', 'readingCount', 'eventCount'])
          && d.schemaVersion == 1 && d.id == tripId
          && d.vehicle in ['auto', 'moto', 'bici']
          && d.start is number && d.start > 0
          && d.end is number && d.end >= d.start
          && (d.distance == null || (d.distance is number && d.distance >= 0))
          && (d.averageRisk == null || (d.averageRisk is number && d.averageRisk >= 0 && d.averageRisk <= 100))
          && d.readingCount is int && d.readingCount >= 0
          && d.eventCount is int && d.eventCount >= 0;
      }
      allow read: if owner();
      allow create, update: if owner() && validSummary();
    }
    // No client access to payments, entitlements, other users or other paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
