# Copia este archivo a .env y usa la configuración de tu aplicación web Firebase.
# Estos valores son públicos. Nunca pongas claves de Stripe ni cuentas de servicio aquí.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Hosted Checkout uses the server; the public key is reserved for a native Stripe UI.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
